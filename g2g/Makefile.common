# -*- mode: make -*-

# Auto-generate header dependencies (.d files) alongside every object so that
# touching a header forces a rebuild of all dependents. Supersedes the manually
# maintained Makefile.depends (which could only ever go stale).
CXXFLAGS+= -fopenmp -fPIC -I. -I$(CUDA_HOME)/include -MMD -MP
# Warning-only diagnostics (no codegen impact). Gated behind `make lint=1`.
ifeq ($(lint),1)
  CXXFLAGS += -Wall -Wextra -Wshadow
endif
OPTIMIZECPU :=

# CPU micro-architecture flags. Overridable so release/packaging builds can
# target a baseline ISA instead of the build host (-march=native binaries
# SIGILL on older CPUs and are not reproducible across machines).
ARCHFLAGS_CPU ?= -march=native

# Determine compiler based on INTEL flag
ifeq ($(intel),0)
  # Use default GNU compiler
  CXX          := g++
  OPTIMIZECPU  := -O3 $(ARCHFLAGS_CPU) -fno-semantic-interposition
  # Suppressions only matter when the lint warnings above are enabled.
  ifeq ($(lint),1)
    CXXFLAGS   := $(CXXFLAGS) -Wno-unused-variable -Wno-unused-parameter -Wno-sign-compare
  endif
else
  # Intel compiler requested; ensure icc is available
  ifeq ($(shell command -v icc >/dev/null 2>&1 && echo yes),)
    $(error Intel compiler (icc) requested but not found. Set intel=0 to fallback to gcc.)
  endif
  CXX          := icc
  OPTIMIZECPU  := -Ofast -xHost -no-prec-div -ipo
  # Safely detect ICC version (old vs new) without bc syntax errors
  ICC_VER_MAJOR := $(shell icc --version | head -n1 | awk -F'.' '{print $$1}' | awk '{print $$3}')
  INTEL_OLD := $(shell echo "$$(($(ICC_VER_MAJOR) < 16))")
  ifeq ($(INTEL_OLD),1)
    CXXFLAGS := $(CXXFLAGS) -opt-report 3
  else
    CXXFLAGS := $(CXXFLAGS) -qopt-report 3
  endif
endif

# Debug/release configuration
ifneq ($(dbg),1)
  # -DNDEBUG strips assert() from release builds (g2g asserts on hot paths).
  CXXFLAGS  += $(OPTIMIZECPU) -DNDEBUG
else
  CXXFLAGS += -D_DEBUG -g -ggdb
endif

# Header prerequisites now come from the auto-generated .d files (-MMD -MP),
# so a single .cpp rule suffices. (The old `%.o:%.c %.h` rule was dead — there
# are no .c sources and CC/CFLAGS were never set.)
%.o:%.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@
