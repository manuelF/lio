################################################################################
# Makefile.options
#
# The following makefile translates the information provided in the form of
# options ("make target opt1=n opt2=m ...") into definitions and flags passed
# to the compiler, libraries included during linking, etc. All customization
# involving options should be included here. The following is the list and
# brief description of currently available options.
#
# cuda : Enables the use of nvidia gpu-boards.
#    0 = GPU disabled.
#    1 = Uses gpu specific kernels.
#    2 = Uses gpu kernels and cublas library.
#    3 = Uses gpu kernels and cublas and magma libraries.
#
# intel : Enables the use of intel compilers.
#    0 = no intel compilers; use gnu fortran compiler and libraries.
#    1 = use the intel compilers instead of the GNU ones.
#    2 = use the intel compilers and the MKL library for lapack.
#
# parallel : Option not enabled yet. Will be reserved for activating the use
# of openmp and mpi.
#
# precision : Increase the precision of some of the internal variables of the
# program.
#    0 = Use lowest real precision whenever possible.
#    1 = Increase precision in ... (TODO).
#
# cpu_precision : selects the precision of _p NOT IMPLEMENTED YED
#    0 = simple precision
#    1 = double precision
#
# analytics : Enables profiling or debugging information and flags.
#    0 = No extra information is provided.
#    1 = Profiling information is enabled.
#    2 = Basic debugging information is enabled.
#    3 = Detailed debugging information is enabled.
#    4 = Detailed debugging information is enabled + integrals checks.
#
################################################################################
#
# -lname tells the linker to look for external procedures in libname library.
#
# -Lpathname tells the linker to look for libraries in pathname.
#
# -Wl,-rpath='pathname' saves pathname inside the executable so it will look
# for libraries there at runtime
#
#
FFLAGS += -fPIC $(DEFINE)

LFLAGS += -fPIC -shared
LFLAGS += -Wl,--no-undefined
# --as-needed drops unused libs (safe under --no-undefined); -Wl,-O1 optimizes
# the symbol hash table.
LFLAGS += -Wl,--as-needed -Wl,-O1
# Faster/safer dynamic loading: full RELRO + eager binding + sorted commons.
LFLAGS += -Wl,-z,relro -Wl,-z,now -Wl,--sort-common
LFLAGS += -Wl,-rpath='$$ORIGIN/'
LFLAGS += -Wl,-rpath='$$ORIGIN/../g2g'

LFLAGS += -L/usr/lib -L/usr/lib64 -L../g2g
LIBS   += -lm -lstdc++ -lg2g

# Is this necessary? We should have no definitions by default
DEFINE  = -Dpack -DG2G

# These variables will be filled by compiler specific flags
OPTIM0P =
OPTIM0I =
DEBUG01 =
DEBUG02 =


################################################################################
ifeq ($(cuda),0)

else ifeq ($(cuda),1)

else ifeq ($(cuda),2)
  DEFINE += -DCUBLAS
  LFLAGS += -L$(CUDA_HOME)/lib64/
  LIBS   += -lcudart -lcublas
  cublas  = 1 # This is necessary for current status of Makefile.depends but
              # should be changed in the future.

else ifeq ($(cuda),3)
  DEFINE += -DCUBLAS
  LFLAGS += -L$(CUDA_HOME)/lib64/
  LIBS   += -lcudart -lcublas
  cublas  = 1 # This is necessary for current status of Makefile.depends
              # should be changed in the future.

  DEFINE += -Dmagma
  LFLAGS += -L$(MAGMAROOT)/lib
  LIBS   += -lmagma

else
  $(error Invalid value in option cuda = $(cuda))
endif


################################################################################
ifeq ($(intel),0)
  FC      = gfortran
  LC      = gfortran
  FFLAGS += -cpp -fopenmp -I$(OBJPATH) -J$(OBJPATH)
  FFLAGS += -fallow-argument-mismatch
  FFLAGS += -fno-math-errno -fno-trapping-math
  FFLAGS += -fprefetch-loop-arrays
  FFLAGS += -fipa-pta
  FFLAGS += -fgraphite-identity -floop-nest-optimize
  FFLAGS += -ffrontend-optimize
  # Verified bit-exact on fosfato (preserve FP evaluation order).
  FFLAGS += -fno-plt
  FFLAGS += -funroll-loops
  FFLAGS += -falign-functions=32 -falign-loops=32
  # -flto, -fno-semantic-interposition and -fexternal-blas are deliberately
  # omitted: fosfato and the TD/Ehrenfest cases spend ~95% of wall in libg2g.so
  # (CUDA) and libopenblas, separate units these FFLAGS do not touch, so there is
  # no measurable speedup; -flto/-fno-semantic-interposition also perturb the
  # FP-sensitive SCF path. -fexternal-blas only helps a large-M Ehrenfest
  # workload (matmul-heavy and matrix-bound); revisit if that becomes a target.
  # See research/fortran/.
  # Overridable CPU arch flags (see g2g/Makefile.common). Default targets the
  # build host; override ARCHFLAGS_FC for portable/reproducible release builds.
  ARCHFLAGS_FC ?= -march=native -mtune=native
  FFLAGS += $(ARCHFLAGS_FC)
  FFLAGS += -fstack-arrays
  # Correctness guards: warning-only, no codegen/FP impact, all at zero across
  # the tree. They keep the default build clean and turn a regression into an
  # immediate diagnostic. Each catches a class of bug that would compile silently:
  #   -Wimplicit-interface  : call to a procedure with no explicit interface
  #   -Waliasing            : aliased dummy arguments
  #   -Wcompare-reals       : fragile REAL == / /= comparison
  #   -Wunused-dummy-argument / -Wunused-variable : vestigial args / dead imports
  #   -Wline-truncation     : source past the line limit silently dropped
  #   -Wcharacter-truncation: CHARACTER assignment/arg truncated
  #   -Wsurprising          : surprising constructs (e.g. non-conformant logic)
  #   -Wreturn-type         : function result never assigned
  #   -Wzerotrip            : DO loop that never executes as written
  #   -Wundefined-do-loop   : DO loop bound overflow / undefined trip count
  #   -Wdo-subscript        : array subscript provably out of bounds at compile time
  #   -Wintrinsic-shadow    : user procedure silently shadows an intrinsic
  #   -Wconversion          : implicit type conversion that may change the value
  #   -Wreal-q-constant     : 'q' real constant losing precision
  #   -Wtarget-lifetime     : pointer outliving its target
  #   -Wc-binding-type      : C-interop kind mismatch
  #   -Wampersand           : missing continuation ampersand (silent string join)
  # -fimplicit-none forbids implicit typing tree-wide, so a mistyped name is a
  # hard error instead of a silent new variable (files with an explicit
  # `implicit real*8(a-h,o-z)` legacy rule are unaffected).
  FFLAGS += -Wimplicit-interface -Waliasing
  FFLAGS += -Wcompare-reals -Wunused-dummy-argument -Wunused-variable
  FFLAGS += -Wline-truncation -Wcharacter-truncation -Wsurprising
  FFLAGS += -Wreturn-type -Wzerotrip -Wundefined-do-loop -Wdo-subscript
  FFLAGS += -Wintrinsic-shadow -Wconversion -Wreal-q-constant
  FFLAGS += -Wtarget-lifetime -Wc-binding-type -Wampersand
  FFLAGS += -fimplicit-none
  # Runtime correctness audit tiers (gated; no effect on the default build).
  # Build with `make check=N`, then run the e2e suite to surface bugs that only
  # appear at execution time:
  #   check=1: array-bounds / do-loop / pointer / memory / recursion violations.
  #   check=2: -finit-real=snan + trap on invalid => any uninitialised REAL used
  #            in arithmetic aborts with a backtrace.
  ifeq ($(check),1)
    FFLAGS += -g -fbacktrace -fcheck=bounds,do,pointer,mem,recursion
  endif
  ifeq ($(check),2)
    FFLAGS += -g -fbacktrace -finit-real=snan -ffpe-trap=invalid
  endif
  # Gated diagnostics still being cleaned up (`make lint=1`):
  #   -Warray-temporaries / -Wrealloc-lhs : hidden heap allocation+copy or a
  #     runtime shape-check+realloc on an assignment (perf; ~305 / ~374 sites).
  #   -Wmaybe-uninitialized : ~153 false positives in the faint_cpu integral
  #     routines (scalar temps the compiler cannot prove assigned-before-use;
  #     confirmed harmless by the check=2 audit).
  #   -Wuse-without-only : module-import hygiene (~161 sites).
  ifeq ($(lint),1)
    FFLAGS += -Warray-temporaries -Wrealloc-lhs
    FFLAGS += -Wmaybe-uninitialized -Wuse-without-only
  endif
  LFLAGS += -L/usr/lib -fopenmp
  # -lopenblas is required so SCF.f90's openblas_set_num_threads_/get_ symbols
  # resolve. The Ubuntu reference libblas.so.3 (which itself maps to OpenBLAS)
  # only exports the standard BLAS interface, not the OpenBLAS thread-control
  # extensions. On non-OpenBLAS systems (Cray, MKL, reference LAPACK) drop
  # -lopenblas and disable the overlap path: leave LIO_OVERLAP_INT3LU_G2G unset.
  LIBS   += -lblas -llapack -lopenblas

  DEBUG01 = -g -Wtabs -fcheck=all
  DEBUG02 = -g -Wall -Wextra -fcheck=all -fbacktrace -pedantic -ffpe-trap=invalid,zero,overflow,underflow
  OPTIM0P = #TODO: no flags for parallelization using gfortran?
  OPTIM0I = #TODO: no flags for precision and inlining using gfortran?


else ifeq ($(intel),1)
  FC      = ifort
  LC      = ifort
  FFLAGS += -fpp -module $(OBJPATH)
  LFLAGS += -L/usr/lib
  LIBS   += -llapack -lblas
  LIBS   += -liomp5 -lpthread

  DEBUG01 = -g -check bounds -traceback
  DEBUG02 = -g -check bounds -traceback -check all -fp-stack-check
  OPTIM0P = -parallel
  OPTIM0I = -mp1 -ip


else ifeq ($(intel),2)
  FC      = ifort
  LC      = ifort
  FFLAGS += -fpp -module $(OBJPATH)
  LFLAGS += -L$(MKLROOT)/lib/intel64 -I$(MKLROOT)/include
  LIBS   += -lmkl_blas95_lp64 -lmkl_lapack95_lp64
  LIBS   += -lmkl_intel_lp64 -lmkl_intel_thread -lmkl_core
  LIBS   += -liomp5 -lpthread

  DEBUG01 = -g -check bounds -traceback
  DEBUG02 = -g -check bounds -traceback -check all -fp-stack-check
  OPTIM0P = -parallel
  OPTIM0I = -mp1 -ip

else
  $(error Invalid value in option intel = $(intel))
endif


################################################################################
ifeq ($(parallel),0)
else
  $(warning This option is not available yet, set it to 0 or avoid it.)
  $(error Invalid value in option parallel = $(parallel))
endif


################################################################################
ifeq ($(precision),0)
  DEFINE += -DTD_SIMPLE

else ifeq ($(precision),1)

else
  $(error Invalid value in option precision = $(precision))
endif


################################################################################
ifeq ($(cpu_precision),0)
  DEFINE += -DCPU_SIMPLE
else ifeq ($(cpu_precision),1)
  DEFINE += -DCPU_DOUBLE
else
  $(error Invalid value in option cpu_precision = $(cpu_precision))
endif


################################################################################
ifeq ($(analytics),0)

else ifeq ($(analytics),1)
  DEFINE += -DPROFILING
  FFLAGS += -pg
  LFLAGS += -pg

else ifeq ($(analytics),2)
  #TODO: DPRINT_MATRICES unnecessary, code should recognize DEBUGGING
  DEFINE += -DDEBUGGING -DPRINT_MATRICES
  FFLAGS += $(DEBUG01)
  LFLAGS += $(DEBUG01)

else ifeq ($(analytics),3)
  #TODO: DPRINT_MATRICES unnecessary, code should recognize DEBUGGING
  DEFINE += -DDEBUGGING -DPRINT_MATRICES
  FFLAGS += $(DEBUG02)
  LFLAGS += $(DEBUG02)
else ifeq ($(analytics),4)
  #TODO: DPRINT_MATRICES unnecessary, code should recognize DEBUGGING
  DEFINE += -DDEBUGGING -DPRINT_MATRICES
  DEFINE += -DFULL_CHECKS
  FFLAGS += $(DEBUG02)
  LFLAGS += $(DEBUG02)

else
  $(error Invalid value in option analytics = $(analytics))
endif


################################################################################
# PRIVATE FLAGS:
#
# The following section assigns to specific OBJECTS certain flags, such as
# which level of optimization corresponds to each object. Intermediate flags
# are used to store the private information and then these option is added
# to the general compilation flags.

private_flag := -O3 

tmplist :=
tmplist += dip.o SCFop.o
tmplist += subm_intfld.o subm_int1G.o subm_int3G.o
tmplist += subm_intsol.o subm_intsolG.o
$(tmplist:%.o=$(OBJPATH)/%.o) : private_flag := -O1 

tmplist :=
tmplist += mathsubs.o matmuldiag.o subm_int3lu.o fock_commuts.o
$(tmplist:%.o=$(OBJPATH)/%.o) : private_flag := -O3 $(OPTIM0P)

tmplist :=
tmplist += SCF.o TD.o ehrenfest.o magnus.o predictor.o
tmplist += FixMessRho.o mulliken.o PackedStorage.f
tmplist += init_amber.o init.o lio_init.o liomain.o lio_finalize.o
tmplist += dft_get_mm_forces.o dft_get_qm_forces.o
tmplist += alg.o drive.o func.o grid.o dipmem.o jarz.o
tmplist += subm_int1.o subm_int2.o subm_int2G.o subm_int3mem.o subm_intSG.o
tmplist += garcha_mod.o cubegen.o density.o
$(tmplist:%.o=$(OBJPATH)/%.o) : private_flag := -O3 $(OPTIM0I)

FFLAGS += $(private_flag)

################################################################################
